{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "start": "deno run --allow-read --allow-write --allow-net --unstable-kv main.ts",
    "build:win": "deno compile --allow-net --allow-read --allow-run --include ./public --target x86_64-pc-windows-msvc --output dist/app_windows.exe main.ts",
    "build:mac": "deno compile --allow-net --allow-read --allow-run --include ./public --target aarch64-apple-darwin --output dist/app_mac main.ts",
    "build:linux": "deno compile --allow-net --allow-read --allow-run --include ./public --target x86_64-unknown-linux-gnu --output dist/app_linux main.ts",
    "build": "deno task build:win && deno task build:mac && deno task build:linux"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
